{
  "expo": {
    "name": "PlantQuest",
    "slug": "plantquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "plantquest",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.rejohnjames.plantquest",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rejohnjames.plantquest",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8E7"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8E7"
        }
      ],
      "expo-sqlite",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}